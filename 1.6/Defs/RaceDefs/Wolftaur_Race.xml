<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!-- need racesettings? -->

<!-- need to define custom basepawn def like in ferian or lapelli race???-->



    <!-- This is the Def that represents your race. -->
    <!-- You can inherit from either "HumanRace" or "BasePawn" depending on what is easier to override. -->
    <AlienRace.ThingDef_AlienRace ParentName="BasePawn">

        <!-- The defName of your Def must be unique across all mods. -->
        <!-- It's recommended that you prefix this with your name or your mod's name to avoid collisions. -->
        <!-- Examples include "Aelanna_Heruan" or "ARR_Miqote" -->
        <defName>QD_Wolftaur</defName>

        <!-- This is the display name of your race that is shown in-game. -->
        <!-- It actually does not need to be unique. -->
        <label>wolftaur</label>

        <!-- This is the description text that is shown when someone inspects a member of your race. -->
        <description>Tauric wolf people</description>

        <!-- The following are all parts of the Humanoid Alien Race framework. -->
        <!-- Please read the HAR Wiki at https://github.com/erdelf/AlienRaces/wiki to see what you can add here! -->
        <alienRace>
            <generalSettings>
				<!-- adds forced race traits, doesn't count for regular trait limit -->
				<forcedRaceTraitEntries>
					<!-- bisexual wolves!!!! -->
					<li>
						<defName>Bisexual</defName>
					</li>
				</forcedRaceTraitEntries>
				
				<!-- add traits you don't want here -->
				<disallowedTraits>
					<li>
						<defName>DislikesMen</defName>
					</li>
					<li>
						<defName>DislikesWomen</defName>
					</li>
				</disallowedTraits>
				
				<!-- probably a good idea to add in case someone isn't using Blunt Social Fights -->
				<maxDamageForSocialfight>4</maxDamageForSocialfight>
				
				<!-- lets them use all human surgery recipes, double check if OK with custom parts? -->
				<humanRecipeImport>true</humanRecipeImport>
				
				<!-- customise graphical aspects of the wolves -->
				<alienPartGenerator>
					
					<!-- head types required as we are inheriting from basepawn -->
					<headTypes Inherit="False">
						<li>Wolftaur_Head</li>
					</headTypes>
					
					<!-- for simplicity, will only use Hulk bodytype -->
					<bodyTypes Inherit="False">
						<li>Hulk</li>
						<!-- Biotech compat? Don't plan on getting it so not tested -->
						<li MayRequire="Ludeon.RimWorld.Biotech">Baby</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Child</li>
					</bodyTypes>
					
					<!-- skin and hair color genes take precedence over color channels, REMEMBER TO DISABLE THE GENES IN RACE RESTRICTIONS -->
					<colorChannels>
						
					</colorChannels>
					<bodyAddons>
						<!-- extended graphics should only be needed if graphics are displayed when specific hediff present -->
						<!-- taurbody settings -->
						<li>

							<path>Common\Textures\Things\Wolftaur\Body\taurbody</path>
							<conditions>
								<BodyPart>
									<bodyPartLabel>taur body</bodyPartLabel>
									<drawWithoutPart>false</drawWithoutPart>
								</BodyPart>
								<RotStage>Fresh,Rotting</RotStage>
								<!-- removes taur body whne in bed -->
								<Posture>
									<drawnStanding>true</drawnStanding>
									<drawnLaying>true</drawnLaying>
									<drawnInBed>false</drawnInBed>
								</Posture>
							</conditions>
						</li>
						<!-- might add ears in the future? -->
					</bodyAddons>
					
				</alienPartGenerator>
			
				<!-- Biotech compat section, I have no biotech so it is untested! -->
				<reproduction MayRequire="Ludeon.RimWorld.Biotech">
					<!-- any gender can reproduce -->
					<fertilizingGender>Either</fertilizingGender>
					<gestatingGender>Either</gestatingGender>
				</reproduction>
			</generalSettings>
			
			<!-- overrides default texture paths -->
            <graphicPaths>
			<!-- assume I need this to have nongendered heads -->
				<head>
					<path>Common\Textures\Things\Wolftaur\Head</path>
				</head>
				<!-- dead :( -->
				<skeleton>Things/Pawn/Animal/Wolf_Timber/Dessicated_Wolf_Timber</skeleton>
			</graphicPaths>
			
			<!-- hair, beard tattoo style settings -->
			<!-- will just disable everything for now and see what to do with hair -->
            <styleSettings>
				<li>
					<key>HairDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>BeardDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>TattooDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
			</styleSettings>
			
			<!-- thoughts that can or can't be received, and replacement thoughts -->
            <thoughtSettings>
				<!-- ground cold and hard, wolf soft and warm -->
				<cannotReceiveThoughts>
					<li>SleptOnGround</li>
					<li>Naked</li>
				</cannotReceiveThoughts>
			</thoughtSettings>
			
			<!-- pawn relations between members of race, don't think I need this -->
            <relationSettings>
			
			</relationSettings>
			
            <raceRestriction>
			<blackGeneList>
					<!-- they have fur already -->
					<li MayRequire="Ludeon.RimWorld.Biotech">Furskin</li>
				</blackGeneList>
				<blackGeneTags>
					<!-- they have tails and fur already -->
					<!-- no hair or beard styles as they are disabled -->
					<li>Tail</li>
					<li>HairStyle</li>
					<li>BeardStyle</li>
					<li>Fur</li>
				</blackGeneTags>
				<!-- not sure what these do but the races I used as reference blacklist these -->
				<blackEndoCategories>
					<li>Melanin</li>
					<li>HairColor</li>
					<li>BodyType</li>
					<li>Ears</li>
					<li>Nose</li>
					<li>Jaw</li>
					<li>Head</li>
					<li>Headbone</li>
				</blackEndoCategories>
			</raceRestriction>
			
			<!-- mod compatibility for alien races-->
            <compatibility>
				<isFlesh>true</isFlesh>
				<isSentient>true</isSentient> 
				<hasBlood>true</hasBlood>
			
			</compatibility>
        </alienRace>
		
		<!-- defines stats for race -->
		<statBases>
			<ComfyTemperatureMin>-20</ComfyTemperatureMin> <!-- base wolf has -40 temp -->
			<ComfyTemperatureMax>36</ComfyTemperatureMax>
			<MoveSpeed>9.0</MoveSpeed> <!-- base human move speed is 4.6, double should be fast enough -->
			<Flammability>1.0</Flammability>
			<MiningSpeed>1.2</MiningSpeed>
			<MeleeDodgeChance>1.1</MeleeDodgeChance>
			
		</statBases>
		
		<!-- defines attack kinds it seems -->
		<tools>
		
		
		</tools>
		
		<!-- defines more stats? -->
		<!-- Ripping these from lapelli and ferian which both use BasePawn and I have experience updating -->
		<race>
			<!-- need this because it inherits from BasePawn -->
			<renderTree>Humanlike</renderTree>
			<thinkTreeMain>Humanlike</thinkTreeMain>
            <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
            <intelligence>Humanlike</intelligence>
            <makesFootprints>true</makesFootprints>
            <lifeExpectancy>80</lifeExpectancy>
			<!-- need to add this or else you can't heal properly -->
			<bloodDef>Filth_Blood</bloodDef>
			<leatherDef>Leather_Wolf</leatherDef>
			<!-- unsure about meat, use wolf or human meat? -->
			<useMeatFrom>Wolf_Timber</useMeatFrom>
			<!-- <useMeatFrom>Human</useMeatFrom> -->
			<!-- end of meat section -->
			<body>Wolftaur_Body</body> <!-- using our custom bodydef -->
			<nuzzleMtbHours>12</nuzzleMtbHours> <!-- nuzzling -->
			<baseBodySize>3.0</baseBodySize> <!-- double size of warg -->
			<baseHealthScale>3.0</baseHealthScale> <!-- wolves are 3x body size so 3x health should be ok? -->
			<baseHungerRate>3.0</baseHungerRate> <!-- the wolves hunger for the sweet taste of kibble -->
			<foodType>OmnivoreHuman</foodType>
			<gestationPeriodDays>90</gestationPeriodDays>
			<litterSizeCurve>
				<points>
				<li>(0.5, 0)</li>
				<li>(1, 1)</li>
				<li>(1.01, 0.01)</li>
				<li>(2, 0)</li>
				</points>
			</litterSizeCurve>
            <lifeStageAges>
				<li>
					<def>HumanlikeBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>HumanlikeChild</def>
					<minAge>5</minAge>
				</li>
				<li>
					<def>HumanlikeTeenager</def>
					<minAge>12</minAge>
				</li>
				<li>
					<def>HumanlikeAdult</def>
					<minAge>18</minAge>
				</li>
            </lifeStageAges>
			<!-- biotech stuff -->
			<lifeStageWorkSettings MayRequire="Ludeon.RimWorld.Biotech">
				<Firefighter>7</Firefighter>
				<Patient>0</Patient>
				<Doctor>10</Doctor>
				<PatientBedRest>0</PatientBedRest>
				<Childcare MayRequire="Ludeon.RimWorld.Biotech">0</Childcare>
				<BasicWorker>7</BasicWorker>
				<Warden>10</Warden>
				<Handling>7</Handling>
				<Cooking>7</Cooking>
				<Hunting>7</Hunting>
				<Construction>10</Construction>
				<Growing>7</Growing>
				<Mining>7</Mining>
				<PlantCutting>7</PlantCutting>
				<Smithing>13</Smithing>
				<Tailoring>7</Tailoring>
				<Art>10</Art>
				<Crafting>7</Crafting>
				<Hauling>3</Hauling>
				<Cleaning>3</Cleaning>
				<Research>13</Research>
			</lifeStageWorkSettings>
			
			<ageGenerationCurve>
                <points>
                    <li MayRequire="Ludeon.RimWorld.Biotech">(0,0)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(0.001,43)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(8,86)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(12.5,118)</li>  <!-- Exclude 12.5-13 years to avoid spawning pawns who are very close to becoming adults -->  
					<li MayRequire="Ludeon.RimWorld.Biotech">(12.51,0)</li>  
					<li MayRequire="Ludeon.RimWorld.Biotech">(13,0)</li>      
					<li MayRequire="Ludeon.RimWorld.Biotech">(13.001,122)</li><!-- End exclude -->
					<li MayRequire="Ludeon.RimWorld.Biotech">(13.999,130)</li>
					<li>(14,0)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(14.001,130)</li>
					<li>(16,100)</li>
					<li>(50,100)</li>
					<li>(60,30)</li>
					<li>(70,18)</li>
					<li>(80,10)</li>
					<li>(90,3)</li>
					<li>(100,0)</li>
                </points>
            </ageGenerationCurve>
			
			<hediffGiverSets>
				<li>OrganicStandard</li>
				<li>Human</li>
			</hediffGiverSets>
			
			<!-- Sounds -->
			<soundWounded>Pawn_Dog_Injured</soundWounded> <!-- wolf noises -->
			<soundDeath>Pawn_Dog_Death</soundDeath>
			<soundMeleeHitPawn>Pawn_Melee_Punch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_Punch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_Punch_Miss</soundMeleeMiss>
		</race>
    </AlienRace.ThingDef_AlienRace>

</Defs>