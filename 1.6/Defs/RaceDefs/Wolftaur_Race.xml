<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!-- need racesettings? -->

<!-- need to define custom basepawn def like in ferian or lapelli race???-->



    <!-- This is the Def that represents your race. -->
    <!-- You can inherit from either "HumanRace" or "BasePawn" depending on what is easier to override. -->
    <AlienRace.ThingDef_AlienRace ParentName="BasePawn">

        <!-- The defName of your Def must be unique across all mods. -->
        <!-- It's recommended that you prefix this with your name or your mod's name to avoid collisions. -->
        <!-- Examples include "Aelanna_Heruan" or "ARR_Miqote" -->
        <defName>QD_Wolftaur</defName>

        <!-- This is the display name of your race that is shown in-game. -->
        <!-- It actually does not need to be unique. -->
        <label>wolftaur</label>

        <!-- This is the description text that is shown when someone inspects a member of your race. -->
        <description>Tauric wolf people, genetically engineered as a replacement for heavy machinery in colonies.</description>

        <!-- The following are all parts of the Humanoid Alien Race framework. -->
        <!-- Please read the HAR Wiki at https://github.com/erdelf/AlienRaces/wiki to see what you can add here! -->
        <alienRace>
            <generalSettings>
				<!-- adds forced race traits, doesn't count for regular trait limit -->
				<forcedRaceTraitEntries>
					<!-- bisexual wolves!!!! -->
					<li>
						<defName>Bisexual</defName>
					</li>
				</forcedRaceTraitEntries>
				
				<!-- add traits you don't want here -->
				<disallowedTraits>
					<li>
						<defName>DislikesMen</defName>
					</li>
					<li>
						<defName>DislikesWomen</defName>
					</li>
				</disallowedTraits>
				
				<!-- probably a good idea to add in case someone isn't using Blunt Social Fights -->
				<maxDamageForSocialfight>4</maxDamageForSocialfight>
				
				<!-- lets them use all human surgery recipes, double check if OK with custom parts? -->
				<humanRecipeImport>true</humanRecipeImport>
				
				<!-- customise graphical aspects of the wolves -->
				<alienPartGenerator>
					
					<!-- head types required as we are inheriting from basepawn, custom def made for ungendered heads -->
					<headTypes Inherit="False">
						<li>Wolftaur_Head</li>
					</headTypes>
					
					<!-- for simplicity, will only use Hulk bodytype -->
					<bodyTypes Inherit="False">
						<li>Hulk</li>
						<!-- Biotech compat? Don't plan on getting it so not tested -->
						<li MayRequire="Ludeon.RimWorld.Biotech">Baby</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Child</li>
					</bodyTypes>
					
					<!-- skin and hair color genes take precedence over color channels, REMEMBER TO DISABLE THE GENES IN RACE RESTRICTIONS -->
					<colorChannels>
						
					</colorChannels>
					<bodyAddons>
						<!-- extended graphics should only be needed if graphics are displayed when specific hediff present -->
						<!-- name format for body parts is "Wolftaur_[BODYPART]_[DIRECTION] -->
						<!-- layerOffsets seem to be -ve for bottom, +ve for top -->
						<!-- layers for east facing are: tail < taurbody < humanbody < leftear < head < hair < rightear -->
						<!-- tail must be below taurbody, ears and hair must be above head (they cover up unwanted lines) -->
						
						<!-- TAURBODY -->
						<li>

							<path>Common\Textures\Things\Wolftaur\Body\Wolftaur_Body</path>
							<conditions>
								<BodyPart>
									<bodyPartLabel>taur body</bodyPartLabel>
									<drawWithoutPart>false</drawWithoutPart>
								</BodyPart>
								<RotStage>Fresh,Rotting</RotStage>
								<!-- removes taur body when in bed -->
								<Posture>
									<drawnStanding>true</drawnStanding>
									<drawnLaying>true</drawnLaying>
									<drawnInBed>false</drawnInBed>
								</Posture>
							</conditions>
						</li>
						
						<!-- ADD EARS -->						
						<!-- RIGHT EAR -->
						<li>
							<conditions>
								<Apparel>
									<!-- I kinda want visible ears because I like it, but here is option to disable when hat is equipped -->
									<!-- <hiddenUnderApparelFor> -->
										<!-- <li>FullHead</li> -->
										<!-- <li>UpperHead</li> -->
									<!-- </hiddenUnderApparelFor> -->
								</Apparel>
								<BodyPart>
									<bodyPart>Ear</bodyPart>
									<bodyPartLabel>right ear</bodyPartLabel>
								</BodyPart>
								<RotStage>Fresh,Rotting</RotStage>
							</conditions>
							<shaderType>Cutout</shaderType>
							<drawSize>1</drawSize>
							<path>Common\Textures\Things\Wolftaur\Ears\Wolftaur_EarRight</path>
							<inFrontOfBody>True</inFrontOfBody>
							<alignWithHead>true</alignWithHead>
							<colorChannel>skin</colorChannel>
							<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
							<defaultOffset>Center</defaultOffset>
							<offsets>
								<south>
									<layerOffset>0.2</layerOffset> <!-- ears in front of head -->
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</south>
								<north>
									<layerOffset>0.2</layerOffset> <!-- ears in front of head -->
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0))</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</north>
								<east>
									<layerOffset>0.2</layerOffset> <!-- ears in front of head -->
									<bodyTypes>
										<Hulk>(0,0))</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0))</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</east>
								<west>
									<!-- draw right ear behind head when facing west, vice versa done for left ear-->
									<layerOffset>-0.2</layerOffset>
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</west>
							</offsets>
						</li>
						
						<!-- LEFT EAR -->
						<li>
							<conditions>
								<Apparel>
									<!-- I kinda want visible ears because I like it, but here is option to disable when hat is equipped -->
									<!-- <hiddenUnderApparelFor> -->
										<!-- <li>FullHead</li> -->
										<!-- <li>UpperHead</li> -->
									<!-- </hiddenUnderApparelFor> -->
								</Apparel>
								<BodyPart>
									<bodyPart>Ear</bodyPart>
									<bodyPartLabel>left ear</bodyPartLabel>
								</BodyPart>
								<RotStage>Fresh,Rotting</RotStage>
							</conditions>
							<shaderType>Cutout</shaderType>
							<drawSize>1</drawSize>
							<path>Common\Textures\Things\Wolftaur\Ears\Wolftaur_EarLeft</path>
							<inFrontOfBody>True</inFrontOfBody>
							<alignWithHead>true</alignWithHead>
							<colorChannel>skin</colorChannel>
							<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
							<defaultOffset>Center</defaultOffset>
							<offsets>
								<south>
									<layerOffset>0.2</layerOffset> <!-- ears in front of head -->
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</south>
								<north>
									<layerOffset>0.2</layerOffset> <!-- ears in front of head -->
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0))</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</north>
								<east>
									<layerOffset>-0.2</layerOffset> <!-- ears behind head -->
									<bodyTypes>
										<Hulk>(0,0))</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0))</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</east>
								<west>
									<layerOffset>0.2</layerOffset> <!-- ear in front of head -->
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</west>
							</offsets>
						</li>
						
						
						<!-- TAIL -->
						<li>
							<shaderType>Cutout</shaderType> <!-- not sure what this does but adding it anyway -->
							<drawSize>1</drawSize>
							<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
							<path>Common\Textures\Things\Wolftaur\Tail\Wolftaur_Tail</path>
							<inFrontOfBody>false</inFrontOfBody>
							<colorChannel>skin</colorChannel> <!-- everything uses skin channel -->
							<defaultOffset>Center</defaultOffset>
							<offsets>
								<south>
								<layerOffset>-0.3</layerOffset>
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0.)</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</south>
								<north>
								<layerOffset>-0.3</layerOffset>
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</north>
								<east>
								<layerOffset>-0.3</layerOffset>
									<bodyTypes>
										<Hulk>(0,0)</Hulk>
										<Child MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Child>
										<Baby MayRequire="Ludeon.RimWorld.Biotech">(0,0)</Baby>
									</bodyTypes>
								</east>
							</offsets>
							<conditions>
								<BodyPart>
									<!-- bodyPart needs an exact BodyPartDef name -->
									<bodyPart>Tail</bodyPart>
									<!-- bodyPartLabel lets it not be drawn when body part is missing -->
									<bodyPartLabel>wolf tail</bodyPartLabel>
								</BodyPart>
								<Apparel>
								<!-- don't think any apparel should affect it -->
								</Apparel>
								<Posture>
									<drawnStanding>true</drawnStanding>
  									<drawnLaying>true</drawnLaying>
  									<drawnInBed>false</drawnInBed>
								</Posture>
								<RotStage>Fresh,Rotting</RotStage>
    						</conditions>
						</li>
						<!-- ADD HAIR-->
					</bodyAddons>
					
				</alienPartGenerator>
			
				<!-- Biotech compat section, I have no biotech so it is untested! -->
				<reproduction MayRequire="Ludeon.RimWorld.Biotech">
					<!-- any gender can reproduce -->
					<fertilizingGender>Either</fertilizingGender>
					<gestatingGender>Either</gestatingGender>
				</reproduction>
			</generalSettings>
			
			<!-- overrides default texture paths -->
			<!-- might need to add paths for ears and taurbody?? -->
            <graphicPaths>
			<!-- assume I need this to have nongendered heads -->
				<head>
					<path>Common\Textures\Things\Wolftaur\Head</path>
				</head>
				<!-- dead :( -->
				<skeleton>Things/Pawn/Animal/Wolf_Timber/Dessicated_Wolf_Timber</skeleton>
			</graphicPaths>
			
			<!-- hair, beard tattoo style settings -->
			<!-- will just disable everything for now and see what to do with hair -->
			<!-- current plan, have universal head shape and give different hairstyles -->
			<!-- vulpoids have hair separated into front and back, might be useful to take a look -->
            <styleSettings>
				<li>
					<key>HairDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>BeardDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>TattooDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
			</styleSettings>
			
			<!-- thoughts that can or can't be received, and replacement thoughts -->
            <thoughtSettings>
				<!-- ground cold and hard, wolf soft and warm -->
				<cannotReceiveThoughts>
					<li>SleptOnGround</li>
					<li>Naked</li>
				</cannotReceiveThoughts>
			</thoughtSettings>
			
			<!-- pawn relations between members of race, don't think I need this -->
            <relationSettings>
			
			</relationSettings>
			
            <raceRestriction>
			<blackGeneList>
					<!-- they have fur already -->
					<li MayRequire="Ludeon.RimWorld.Biotech">Furskin</li>
				</blackGeneList>
				<blackGeneTags>
					<!-- they have tails and fur already -->
					<!-- no hair or beard styles as they are disabled -->
					<li>Tail</li>
					<li>HairStyle</li>
					<li>BeardStyle</li>
					<li>Fur</li>
				</blackGeneTags>
				<!-- not sure what these do but the races I used as reference blacklist these -->
				<blackEndoCategories>
					<li>Melanin</li>
					<li>HairColor</li>
					<li>BodyType</li>
					<li>Ears</li>
					<li>Nose</li>
					<li>Jaw</li>
					<li>Head</li>
					<li>Headbone</li>
				</blackEndoCategories>
			</raceRestriction>
			
			<!-- mod compatibility for alien races-->
            <compatibility>
				<isFlesh>true</isFlesh>
				<isSentient>true</isSentient> 
				<hasBlood>true</hasBlood>
			
			</compatibility>
        </alienRace>
		
		<!-- defines stats for race -->
		<statBases>
			<ComfyTemperatureMin>-20</ComfyTemperatureMin> <!-- base wolf has -40 temp -->
			<ComfyTemperatureMax>36</ComfyTemperatureMax>
			<MoveSpeed>9.0</MoveSpeed> <!-- base human move speed is 4.6, double should be fast enough -->
			<Flammability>1.0</Flammability>
			<MiningSpeed>1.2</MiningSpeed>
			<MeleeDodgeChance>1.1</MeleeDodgeChance>
			<CarryingCapacity>300</CarryingCapacity> <!-- they are designed to replace heavy machinery -->
			<MarketValue>4500</MarketValue> <!-- base human is 1750, this seems right??? -->
			<Mass>180</Mass> <!-- base human is 60kg -->
			<LeatherAmount>150</LeatherAmount> <!-- base is 75-->
			<MeatAmount>300</MeatAmount> <!-- base is 140-->
			
			<!-- work stats -->
			<WorkSpeedGlobal>1.1</WorkSpeedGlobal>
			<ResearchSpeed>0.9</ResearchSpeed> <!-- slightly worse at fine detail work -->
			<GlobalLearningFactor>1</GlobalLearningFactor>
			<MiningSpeed>1.2</MiningSpeed> <!-- strong wolf -->
			<ConstructionSpeed>1.2</ConstructionSpeed>
		</statBases>
		
		<!-- defines attack kinds it seems -->
		<tools>
			<!-- big chomp -->
			<li>
				<label>teeth</label>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>10</power>
				<cooldownTime>1</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
			</li>
			
			<!-- punching with hands, ripped from base humanlike -->
			<li>
				<label>left fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities>
				  <li>Blunt</li>
				</capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
				<surpriseAttack>
				  <extraMeleeDamages>
					<li>
					  <def>Stun</def>
					  <amount>14</amount>
					</li>
				  </extraMeleeDamages>
				</surpriseAttack>
			</li>
			<li>
				<label>right fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities>
				  <li>Blunt</li>
				</capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
				<surpriseAttack>
				  <extraMeleeDamages>
					<li>
					  <def>Stun</def>
					  <amount>14</amount>
					</li>
				  </extraMeleeDamages>
				</surpriseAttack>
			</li>
			
			<!-- scratches with lower paws, ripped from base WildCanines, specifically wargs-->
			<li>
				<label>left claw</label>
				<labelNoLocation>claw</labelNoLocation>
				<capacities>
				  <li>Scratch</li>
				</capacities>
				<power>10.9</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
				<surpriseAttack>
				  <extraMeleeDamages>
					<li>
					  <def>Stun</def>
					  <amount>14</amount>
					</li>
				  </extraMeleeDamages>
				</surpriseAttack>
				<chanceFactor>0.5</chanceFactor>
			  </li>
			  <li>
				<label>right claw</label>
				<labelNoLocation>claw</labelNoLocation>
				<capacities>
				  <li>Scratch</li>
				</capacities>
				<power>10.9</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
				<surpriseAttack>
				  <extraMeleeDamages>
					<li>
					  <def>Stun</def>
					  <amount>14</amount>
					</li>
				  </extraMeleeDamages>
				</surpriseAttack>
				<chanceFactor>0.5</chanceFactor>
			  </li>
		
		</tools>
		
		<!-- defines base game stats? -->
		<race>
			<!-- need this because it inherits from BasePawn -->
			<renderTree>Humanlike</renderTree>
			<thinkTreeMain>Humanlike</thinkTreeMain>
            <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
            <intelligence>Humanlike</intelligence>
			<nameCategory>HumanStandard</nameCategory> <!-- I assume this gives them regular human namegen -->
            <makesFootprints>true</makesFootprints>
            <lifeExpectancy>80</lifeExpectancy>
			<!-- need to add this or else you can't heal properly -->
			<bloodDef>Filth_Blood</bloodDef>
			<leatherDef>Leather_Wolf</leatherDef>
			<!-- unsure about meat, use wolf or human meat? -->
			<useMeatFrom>Wolf_Timber</useMeatFrom>
			<!-- <useMeatFrom>Human</useMeatFrom> -->
			<!-- end of meat section -->
			<body>Wolftaur_Body</body> <!-- using our custom bodydef -->
			<nuzzleMtbHours>12</nuzzleMtbHours> <!-- nuzzling -->
			<baseBodySize>3.0</baseBodySize> <!-- double size of warg -->
			<baseHealthScale>2.0</baseHealthScale> <!-- 2x health should be ok? -->
			<baseHungerRate>3.0</baseHungerRate> <!-- the wolves hunger for the sweet taste of kibble -->
			<foodType>OmnivoreHuman, CarnivoreAnimal</foodType>
			<gestationPeriodDays>90</gestationPeriodDays>
			<manhunterOnDamageChance>0.20</manhunterOnDamageChance>
			<manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
			<litterSizeCurve>
				<points>
				<li>(0.5, 0)</li>
				<li>(1, 1)</li>
				<li>(1.01, 0.01)</li>
				<li>(2, 0)</li>
				</points>
			</litterSizeCurve>
            <lifeStageAges>
				<li>
					<def>HumanlikeBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>HumanlikeChild</def>
					<minAge>5</minAge>
				</li>
				<li MayRequire="Ludeon.RimWorld.Biotech">
					<def>HumanlikePreTeenager</def>
					<minAge>9</minAge>
				</li>
				<li>
					<def>HumanlikeTeenager</def>
					<minAge>13</minAge>
				</li>
				<li>
					<def>HumanlikeAdult</def>
					<minAge>18</minAge>
				</li>
            </lifeStageAges>
			<!-- biotech stuff -->
			<lifeStageWorkSettings MayRequire="Ludeon.RimWorld.Biotech">
				<Firefighter>7</Firefighter>
				<Patient>0</Patient>
				<Doctor>10</Doctor>
				<PatientBedRest>0</PatientBedRest>
				<Childcare MayRequire="Ludeon.RimWorld.Biotech">0</Childcare>
				<BasicWorker>7</BasicWorker>
				<Warden>10</Warden>
				<Handling>7</Handling>
				<Cooking>7</Cooking>
				<Hunting>7</Hunting>
				<Construction>10</Construction>
				<Growing>7</Growing>
				<Mining>7</Mining>
				<PlantCutting>7</PlantCutting>
				<Smithing>13</Smithing>
				<Tailoring>7</Tailoring>
				<Art>10</Art>
				<Crafting>7</Crafting>
				<Hauling>3</Hauling>
				<Cleaning>3</Cleaning>
				<Research>13</Research>
			</lifeStageWorkSettings>
			
			<ageGenerationCurve>
                <points>
                    <li MayRequire="Ludeon.RimWorld.Biotech">(0,0)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(0.001,43)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(8,86)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(12.5,118)</li>  <!-- Exclude 12.5-13 years to avoid spawning pawns who are very close to becoming adults -->  
					<li MayRequire="Ludeon.RimWorld.Biotech">(12.51,0)</li>  
					<li MayRequire="Ludeon.RimWorld.Biotech">(13,0)</li>      
					<li MayRequire="Ludeon.RimWorld.Biotech">(13.001,122)</li><!-- End exclude -->
					<li MayRequire="Ludeon.RimWorld.Biotech">(13.999,130)</li>
					<li>(14,0)</li>
					<li MayRequire="Ludeon.RimWorld.Biotech">(14.001,130)</li>
					<li>(16,100)</li>
					<li>(50,100)</li>
					<li>(60,30)</li>
					<li>(70,18)</li>
					<li>(80,10)</li>
					<li>(90,3)</li>
					<li>(100,0)</li>
                </points>
            </ageGenerationCurve>
			
			<hediffGiverSets>
				<li>OrganicStandard</li>
				<li>Human</li>
			</hediffGiverSets>
			
			<!-- Sounds -->
			<soundWounded>Pawn_Dog_Injured</soundWounded> <!-- wolf noises -->
			<soundDeath>Pawn_Dog_Death</soundDeath>
			<soundMeleeHitPawn>Pawn_Melee_Punch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_Punch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_Punch_Miss</soundMeleeMiss>
		</race>
		
		<!--anomaly compat? -->
		<comps>
			<li MayRequire="Ludeon.RimWorld.Anomaly" Class="CompProperties_HoldingPlatformTarget">
				<baseEscapeIntervalMtbDays>120</baseEscapeIntervalMtbDays>
				<getsColdContainmentBonus>true</getsColdContainmentBonus>
			</li>
			<li MayRequire="Ludeon.RimWorld.Anomaly" Class="CompProperties_Studiable">
				<frequencyTicks>120000</frequencyTicks>
				<minMonolithLevelForStudy>1</minMonolithLevelForStudy>
			<requiresImprisonment>true</requiresImprisonment>
			</li>
		</comps>
    </AlienRace.ThingDef_AlienRace>

</Defs>