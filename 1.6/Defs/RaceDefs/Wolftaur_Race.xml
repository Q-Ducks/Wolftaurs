<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- This is the Def that represents your race. -->
    <!-- You can inherit from either "HumanRace" or "BasePawn" depending on what is easier to override. -->
    <AlienRace.ThingDef_AlienRace ParentName="BasePawn">

        <!-- The defName of your Def must be unique across all mods. -->
        <!-- It's recommended that you prefix this with your name or your mod's name to avoid collisions. -->
        <!-- Examples include "Aelanna_Heruan" or "ARR_Miqote" -->
        <defName>QD_Wolftaur</defName>

        <!-- This is the display name of your race that is shown in-game. -->
        <!-- It actually does not need to be unique. -->
        <label>wolftaur</label>

        <!-- This is the description text that is shown when someone inspects a member of your race. -->
        <description>Tauric wolf people</description>

        <!-- The following are all parts of the Humanoid Alien Race framework. -->
        <!-- Please read the HAR Wiki at https://github.com/erdelf/AlienRaces/wiki to see what you can add here! -->
        <alienRace>
            <generalSettings>
				<!-- adds forced race traits, doesn't count for regular trait limit -->
				<forcedRaceTraitEntries>
					<!-- bisexual wolves!!!! -->
					<li>
						<defName>Bisexual</defName>
					</li>
				</forcedRaceTraitEntries>
				
				<!-- add traits you don't want here -->
				<disallowedTraits>
					<li>
						<defName>DislikesMen</defName>
					</li>
					<li>
						<defName>DislikesWomen</defName>
					</li>
				</disallowedTraits>
				
				<!-- probably a good idea to add in case someone isn't using Blunt Social Fights -->
				<maxDamageForSocialfight>4</maxDamageForSocialfight>
				
				<!-- lets them use all human surgery recipes, double check if OK with custom parts? -->
				<humanRecipeImport>true</humanRecipeImport>
				
				<!-- customise graphical aspects of the wolves -->
				<alienPartGenerator>
					
					<!-- head types required as we are inheriting from basepawn -->
					<headTypes Inherit="False">
						<li>Wolftaur_Head</li>
					</headTypes>
					
					<!-- for simplicity, will only use Hulk bodytype -->
					<bodyTypes Inherit="False">
						<li>Hulk</li>
						<!-- Biotech compat? Don't plan on getting it so not tested -->
						<li MayRequire="Ludeon.RimWorld.Biotech">Baby</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Child</li>
					</bodyTypes>
					
					<!-- skin and hair color genes take precedence over color channels, REMEMBER TO DISABLE THE GENES IN RACE RESTRICTIONS -->
					<colorChannels>
						
					</colorChannels>
					<bodyAddons>
						<!-- extended graphics should only be needed if graphics are displayed when specific hediff present -->
						<!-- taurbody settings -->
						<li>

							<path>Common\Textures\Things\Wolftaur\Body\taurbody</path>
							<conditions>
								<BodyPart>
									<bodyPartLabel>taur body</bodyPartLabel>
									<drawWithoutPart>false</drawWithoutPart>
								</BodyPart>
								<RotStage>Fresh,Rotting</RotStage>
								<!-- removes taur body whne in bed -->
								<Posture>
									<drawnStanding>true</drawnStanding>
									<drawnLaying>true</drawnLaying>
									<drawnInBed>false</drawnInBed>
								</Posture>
							</conditions>
						</li>
						<!-- might add ears in the future? -->
					</bodyAddons>
					
				</alienPartGenerator>
			
				<!-- Biotech compat section, I have no biotech so it is untested! -->
				<reproduction MayRequire="Ludeon.RimWorld.Biotech">
					<!-- any gender can reproduce -->
					<fertilizingGender>Either</fertilizingGender>
					<gestatingGender>Either</gestatingGender>
				</reproduction>
			</generalSettings>
			
			<!-- overrides default texture paths -->
            <graphicPaths>
			<!-- assume I need this to have nongendered heads -->
				<head>
					<path>Common\Textures\Things\Wolftaur\Head</path>
				</head>
				<!-- dead :( -->
				<skeleton>Things/Pawn/Animal/Wolf_Timber/Dessicated_Wolf_Timber</skeleton>
			</graphicPaths>
			
			<!-- hair, beard tattoo style settings -->
			<!-- will just disable everything for now and see what to do with hair -->
            <styleSettings>
				<li>
					<key>HairDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>BeardDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>TattooDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
			</styleSettings>
			
			<!-- thoughts that can or can't be received, and replacement thoughts -->
            <thoughtSettings>
				<!-- ground cold and hard, wolf soft and warm -->
				<cannotReceiveThoughts>
					<li>SleptOnGround</li>
					<li>Naked</li>
				</cannotReceiveThoughts>
			</thoughtSettings>
			
			<!-- pawn relations between members of race, don't think I need this -->
            <relationSettings>
			
			</relationSettings>
			
            <raceRestriction>
			<blackGeneList>
					<!-- they have fur already -->
					<li MayRequire="Ludeon.RimWorld.Biotech">Furskin</li>
				</blackGeneList>
				<blackGeneTags>
					<!-- they have tails and fur already -->
					<!-- no hair or beard styles as they are disabled -->
					<li>Tail</li>
					<li>HairStyle</li>
					<li>BeardStyle</li>
					<li>Fur</li>
				</blackGeneTags>
				<!-- not sure what these do but the races I used as reference blacklist these -->
				<blackEndoCategories>
					<li>Melanin</li>
					<li>HairColor</li>
					<li>BodyType</li>
					<li>Ears</li>
					<li>Nose</li>
					<li>Jaw</li>
					<li>Head</li>
					<!-- impid mini horns appear over eyes -->
					<li>Headbone</li>
				</blackEndoCategories>
			</raceRestriction>
			
			<!-- mod compatibility for alien races-->
            <compatibility>
			
			</compatibility>
        </alienRace>
    </AlienRace.ThingDef_AlienRace>

</Defs>